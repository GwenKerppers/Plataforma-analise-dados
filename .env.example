# Copie para .env e ajuste. NUNCA commite o .env.
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=analise
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=analise
DATABASE_URL=postgresql+psycopg://analise:change-me-local-only@db:5432/analise

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (compatível com S3)
MINIO_ROOT_USER=analise
MINIO_ROOT_PASSWORD=change-me-local-only
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=analise

# Autenticação (Fase 1) - gere um valor aleatório longo por ambiente
JWT_SECRET=change-me-generate-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Armazenamento S3 (só necessário a partir da Fase 2; use: docker compose --profile storage up)
# Imagem de um servidor S3 compatível. Ver docs/decisions/007-backend-s3.md
S3_IMAGE=
